@code {
    private static readonly (string Id, string Title)[] Sections =
    [
        ("overview", "Overview"),
        ("lab", "The lab: real containers"),
        ("play", "What happens when you play"),
        ("judging", "How a wave is judged"),
        ("design", "System design"),
        ("safety", "Keeping the lab safe"),
        ("tech", "Technology"),
        ("repo", "The project"),
    ];

    private static readonly string[] PlainsRoles = ["citizens", "garrison", "defias", "probe"];

    private static readonly (string Key, string What, bool Open)[] Doors =
    [
        ("web.http", "notice board, for everyone", true),
        ("web.management", "SSH, garrison only", false),
        ("web.debug", "debug page, nobody", false),
        ("web.database", "database, nobody", false),
    ];

    private Scenario _scenario = default!;
    private LabRun? _run;
    // An example until the running lab, if any, has been read from Docker.
    private LabSpec _spec = SentinelHill.Create(1);
    private string? _dockerError;

    protected override void OnInitialized() => _scenario = Game.LoadScenario();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(5));
            var runs = await Lab.ListAsync(timeout.Token);
            _run = runs.FirstOrDefault(r => r.RunId == Game.View.RunId) ?? runs.FirstOrDefault();
        }
        catch (Exception e) when (e is DockerException or LabException or HttpRequestException or IOException or OperationCanceledException
                                     or System.Net.Sockets.SocketException)
        {
            _dockerError = e.Message;
        }
        if (_run is not null) _spec = _run.Spec;
    }

    private string RoleName(string role) => Game.Theme.Label(role switch
    {
        "defias" => "raiders",
        "probe" => "travellers",
        "web" => "board",
        _ => role,
    });

    private string Subnet(string key) => _spec.Networks.First(n => n.Key == key).Subnet;

    private string Address(string role, string network) => _spec.Node(role).AddressOn(network);

    private string Port(string key) => _spec.Parameters.GetValueOrDefault(key, "?");
}
