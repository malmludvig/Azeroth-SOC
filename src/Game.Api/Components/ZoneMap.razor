@* The zone map as a pixel-art scene: the fields and their people on the left,
   the wall and its gate in the middle, the town and the notice board's hall
   on the right. The still parts come from PixelArt and are drawn once; this
   component draws what changes: the gate, the doors as the hosts on the
   plains can see them right now, and the traffic during a wave. *@
@using System.Globalization

<div class="scene">
    <svg class="map" viewBox="0 0 @PixelArt.Width @PixelArt.Height" role="img"
         aria-label="@($"{Theme.Label("plains")}, the gate and {Theme.Label("town")}")">
        @_background

        @* The gate: a lowered portcullis once the gate shuts what it should, an open arch before. *@
        @if (PortcullisDown)
        {
            <g class="portcullis">
                @for (var x = PixelArt.GateX + 1; x < PixelArt.GateX + PixelArt.GateWidth; x += 2)
                {
                    <rect x="@x" y="72" width="1" height="@(PixelArt.Ground - 72)" fill="#8a8c90" />
                }
                <rect x="@PixelArt.GateX" y="78" width="@PixelArt.GateWidth" height="1" fill="#8a8c90" />
                <rect x="@PixelArt.GateX" y="86" width="@PixelArt.GateWidth" height="1" fill="#8a8c90" />
            </g>
        }

        <g class="torches @(View.Phase == GamePhase.Judging ? "bright" : "")">
            <rect x="126" y="66" width="1" height="4" fill="#5a4030" />
            <rect x="125.5" y="63" width="2" height="3" class="flame" />
            <rect x="145" y="66" width="1" height="4" fill="#5a4030" />
            <rect x="144.5" y="63" width="2" height="3" class="flame" />
        </g>

        @foreach (var (name, x) in PixelArt.Doors)
        {
            var door = View.Doors.FirstOrDefault(d => d.Name == name);
            var (state, text) = Describe(door, Theme);
            var open = door?.OutsidersReach == true;
            <g class="door @state">
                <title>@(door is null ? "Which doors answer? Find out from the gate." : $"{Name(name)} {door.Port}: {text}")</title>
                <rect x="@(x - 1)" y="@(PixelArt.DoorTop - 1)" width="@(PixelArt.DoorWidth + 2)" height="@(PixelArt.Ground - PixelArt.DoorTop + 1)" fill="#3a2814" />
                @if (open)
                {
                    <rect x="@x" y="@PixelArt.DoorTop" width="@PixelArt.DoorWidth" height="@(PixelArt.Ground - PixelArt.DoorTop)" fill="#0b0b09" />
                    <rect x="@x" y="@(PixelArt.Ground - 3)" width="@PixelArt.DoorWidth" height="3" fill="#3a2e1a" />
                    <rect x="@(x + PixelArt.DoorWidth - 2)" y="@PixelArt.DoorTop" width="2" height="@(PixelArt.Ground - PixelArt.DoorTop)" fill="#8a6a3e" />
                }
                else
                {
                    <rect x="@x" y="@PixelArt.DoorTop" width="@PixelArt.DoorWidth" height="@(PixelArt.Ground - PixelArt.DoorTop)" fill="#8a6a3e" />
                    @for (var plank = x + 3; plank < x + PixelArt.DoorWidth; plank += 3)
                    {
                        <rect x="@plank" y="@PixelArt.DoorTop" width="1" height="@(PixelArt.Ground - PixelArt.DoorTop)" fill="#6b4f2c" />
                    }
                    <rect x="@(x + PixelArt.DoorWidth - 3)" y="84" width="1" height="2" fill="#2a2a2a" />
                }
                <circle cx="@(x + PixelArt.DoorWidth / 2.0)" cy="@(PixelArt.DoorTop - 5)" r="2" class="lamp" />
                @if (door?.GarrisonReach == true)
                {
                    <rect x="@(x + PixelArt.DoorWidth + 2)" y="80" width="3" height="4" fill="#3a5ea8" />
                    <rect x="@(x + PixelArt.DoorWidth + 3)" y="84" width="1" height="1" fill="#3a5ea8" />
                }
                <text x="@(x + PixelArt.DoorWidth / 2.0)" y="101.5" text-anchor="middle" class="door-label">@(door is null ? "?" : $"{Name(name)} {door.Port}")</text>
            </g>
        }

        @if (View.Phase == GamePhase.Judging)
        {
            @foreach (var (kind, x) in PixelArt.People)
            {
                var (target, passes) = Destination(kind);
                var path = passes
                    ? Invariant($"M{x} {PixelArt.Ground - 2} L{PixelArt.GateX + PixelArt.GateWidth / 2.0} {PixelArt.Ground - 2} L{target} {PixelArt.Ground - 2}")
                    : Invariant($"M{x} {PixelArt.Ground - 2} L{PixelArt.GateX - 3} {PixelArt.Ground - 2}");
                @for (var i = 0; i < 3; i++)
                {
                    <g class="walker">
                        <rect x="-1" y="-3" width="2" height="3" fill="@PixelArt.TrafficColours[kind]" />
                        <rect x="-1" y="-4" width="2" height="1" fill="#e0b48a" />
                        @if (passes)
                        {
                            <animateMotion dur="2.4s" begin="@Invariant($"{i * 0.8 + Offset(kind)}s")" repeatCount="indefinite" path="@path" />
                        }
                        else
                        {
                            @* Turned back at the gate. *@
                            <animateMotion dur="2.4s" begin="@Invariant($"{i * 0.8 + Offset(kind)}s")" repeatCount="indefinite" path="@path"
                                           keyPoints="0;1;0" keyTimes="0;0.5;1" calcMode="linear" />
                        }
                    </g>
                }
            }
        }
    </svg>

    <div class="map-legend">
        @if (View.Doors.Count == 0)
        {
            <span>Which doors does the notice board answer on? Find out from the gate.</span>
        }
        else
        {
            <span><i class="dot good"></i>open, as it should be</span>
            <span><i class="dot bad"></i>open to @Theme.Label("raiders")</span>
            <span><i class="dot shut"></i>shut</span>
            <span><i class="dot warn"></i>@Theme.Label("citizens") shut out</span>
            <span><i class="dot garrison"></i>@Theme.Label("garrison") gets in</span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public GameView View { get; set; } = GameView.Empty;

    [Parameter, EditorRequired] public Theme Theme { get; set; } = default!;

    private MarkupString _background;

    protected override void OnInitialized() => _background = new MarkupString(PixelArt.Background(Theme.Label));

    // The portcullis is down once every door that should be shut to outsiders is.
    private bool PortcullisDown =>
        View.Doors.Count > 0 && View.Doors.Where(d => !d.Public).All(d => d.OutsidersReach == false);

    // Where a kind's traffic goes during a wave, from the doors as last measured:
    // raiders to the first forbidden door left open, the garrison to its
    // management door, everyone else to the web door. Turned back if shut.
    private (double Target, bool Passes) Destination(string kind)
    {
        double Centre(string name) => PixelArt.Doors.First(d => d.Name == name).X + PixelArt.DoorWidth / 2.0;
        Door? Find(string name) => View.Doors.FirstOrDefault(d => d.Name == name);

        switch (kind)
        {
            case "raiders":
                var breach = View.Doors.FirstOrDefault(d => !d.Public && d.OutsidersReach == true);
                return breach is not null ? (Centre(breach.Name), true) : (0, false);
            case "garrison":
                return (Centre("management"), Find("management")?.GarrisonReach != false);
            default:
                return (Centre("http"), Find("http")?.OutsidersReach != false);
        }
    }

    private static double Offset(string kind) => kind switch
    {
        "citizens" => 0,
        "garrison" => 0.3,
        "raiders" => 0.15,
        _ => 0.45,
    };

    private static string Invariant(FormattableString text) => text.ToString(CultureInfo.InvariantCulture);

    private static string Name(string name) => name switch
    {
        "http" => "web",
        "management" => "mgmt",
        "database" => "db",
        _ => name,
    };

    private static (string State, string Text) Describe(Door? door, Theme theme)
    {
        if (door?.OutsidersReach is null) return ("unknown", "?");
        var reach = door.OutsidersReach.Value;
        var (state, text) = (door.Public, reach) switch
        {
            (true, true) => ("good", "open to all"),
            (true, false) => ("warn", $"{theme.Label("citizens")} shut out"),
            (false, true) => ("bad", $"open to {theme.Label("raiders")}"),
            (false, false) => ("shut", "shut"),
        };
        if (door.GarrisonReach is { } garrison) text += $", {theme.Label("garrison")} {(garrison ? "in" : "out")}";
        return (state, text);
    }
}
