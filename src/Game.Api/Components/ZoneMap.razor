@* The zone map: the plains, the gate and the town, with the notice board's
   doors as the hosts on the plains can see them right now. While a wave is
   judged, traffic moves from the plains through the gate. *@

<svg class="map" viewBox="0 0 760 262" role="img" aria-label="Zone map: the plains, the gate and the town">
    <defs>
        <pattern id="wall" width="12" height="12" patternUnits="userSpaceOnUse">
            <rect width="12" height="12" fill="#2a2f24" />
            <path d="M0 6H12M6 0V6M0 12V6" stroke="#3a4232" stroke-width="1.2" />
        </pattern>
    </defs>

    <g class="zone">
        <rect x="12" y="20" width="300" height="230" rx="10" />
        <text x="26" y="44" class="zone-title">@Theme.Label("plains")</text>
    </g>
    <g class="zone">
        <rect x="448" y="20" width="300" height="230" rx="10" />
        <text x="462" y="44" class="zone-title">@Theme.Label("town")</text>
    </g>

    @foreach (var host in Hosts)
    {
        <path d="@Route(host)" class="route" />
    }

    <g class="gate @(View.Phase == GamePhase.Judging ? "busy" : "")">
        <rect x="352" y="20" width="56" height="230" rx="4" fill="url(#wall)" />
        <rect x="364" y="112" width="32" height="52" rx="14" class="gate-opening" />
        <text x="380" y="40" text-anchor="middle" class="gate-title">@Theme.Label("gate")</text>
    </g>

    @foreach (var host in Hosts)
    {
        <g class="host @host.Kind">
            <circle cx="@host.X" cy="@host.Y" r="13" />
            <text x="@(host.X - 24)" y="@(host.Y + 5)" text-anchor="end">@Theme.Label(host.Kind)</text>
        </g>
    }

    @if (View.Phase == GamePhase.Judging)
    {
        @foreach (var host in Hosts)
        {
            @for (var i = 0; i < 3; i++)
            {
                <circle r="4" class="packet @host.Kind">
                    <animateMotion dur="1.8s" begin="@($"{i * 0.6:0.0}s")" repeatCount="indefinite" path="@Route(host)" />
                </circle>
            }
        }
    }

    <g class="board">
        <rect x="470" y="58" width="258" height="176" rx="8" />
        <text x="484" y="82" class="board-title">@Theme.Label("board")</text>
        @if (View.Doors.Count == 0)
        {
            @* In a code block Razor reads a bare <text> as its own tag, so wrap it. *@
            <g>
                <text x="484" y="128" class="hint-text">Which doors answer?</text>
                <text x="484" y="150" class="hint-text">Find out from the gate.</text>
            </g>
        }
        else
        {
            @for (var i = 0; i < View.Doors.Count; i++)
            {
                var door = View.Doors[i];
                var y = 104 + i * 34;
                var (state, text) = Describe(door, Theme);
                <g class="door @state">
                    <rect x="484" y="@(y - 12)" width="14" height="28" rx="2" />
                    <text x="508" y="@y">@Name(door.Name) @door.Port</text>
                    <text x="508" y="@(y + 14)" class="door-state">@text</text>
                </g>
            }
        }
    </g>
</svg>

@code {
    [Parameter, EditorRequired] public GameView View { get; set; } = GameView.Empty;

    [Parameter, EditorRequired] public Theme Theme { get; set; } = default!;

    private sealed record Host(string Kind, int X, int Y);

    // The kinds name the theme's labels; the roles behind them are citizens, garrison, defias and probe.
    private static readonly Host[] Hosts =
    [
        new("citizens", 262, 76),
        new("garrison", 262, 126),
        new("raiders", 262, 176),
        new("travellers", 262, 226),
    ];

    // From the host's right edge, through the gate's opening, to the board.
    private static string Route(Host host) => $"M{host.X + 13} {host.Y} C 330 {host.Y} 330 138 380 138 S 440 146 470 146";

    private static string Name(string name) => name switch
    {
        "http" => "web",
        "debug" => "debug page",
        _ => name,
    };

    private static (string State, string Text) Describe(Door door, Theme theme)
    {
        if (door.OutsidersReach is null) return ("unknown", "?");
        var reach = door.OutsidersReach.Value;
        var (state, text) = (door.Public, reach) switch
        {
            (true, true) => ("good", "open to all"),
            (true, false) => ("warn", $"{theme.Label("citizens")} shut out"),
            (false, true) => ("bad", $"open to {theme.Label("raiders")}"),
            (false, false) => ("shut", "shut"),
        };
        if (door.GarrisonReach is { } garrison) text += $", {theme.Label("garrison")} {(garrison ? "in" : "out")}";
        return (state, text);
    }
}
