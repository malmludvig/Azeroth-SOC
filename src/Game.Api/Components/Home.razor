@page "/"
@* The game screen: map and terminal on the left, the mission on the right.
   Everything shown comes from the GameHost; this page only draws it and
   starts or stops the game. *@
@inject GameHost Game
@inject IJSRuntime JS
@implements IDisposable

<div class="app">
    <header>
        <strong class="title">@(string.IsNullOrEmpty(_view.ScenarioTitle) ? _scenario.Title : _view.ScenarioTitle)</strong>

        <ol class="waves">
            @foreach (var (number, title) in _view.Waves.Count > 0 ? _view.Waves : _scenario.Waves.OrderBy(w => w.Number).Select(w => (w.Number, w.Title)).ToList())
            {
                var done = _view.Outcomes.Any(o => o.Wave == number);
                var current = _view.CurrentWave == number && _view.Phase != GamePhase.Completed;
                <li class="@(done ? "done" : "") @(current ? "current" : "")" title="@title">@number</li>
            }
        </ol>

        <span class="xp">@_view.TotalXp XP</span>

        <span class="controls">
            @if (_view.Active)
            {
                <span class="phase">@PhaseText</span>
                <button class="secondary cheat @(_view.CheatMode ? "on" : "")" @onclick="ToggleCheat"
                        title="Shows the answer to every wave. Waves not yet held then give 10 XP and are not mastered.">
                    @(_view.CheatMode ? "Hide answers" : "Cheat mode")
                </button>
                <button class="secondary" @onclick="StopAsync" disabled="@_busy">Stop</button>
            }
            else
            {
                <label>
                    Start at wave
                    <select @bind="_firstWave">
                        @foreach (var n in _waveChoices)
                        {
                            <option value="@n">@n</option>
                        }
                    </select>
                </label>
                <button @onclick="StartAsync" disabled="@_busy">@(_view.Phase == GamePhase.Idle ? "Start" : "Play again")</button>
            }
        </span>
    </header>

    <main>
        <section class="left">
            <ZoneMap View="_view" Theme="Game.Theme" />
            <GateTerminal />
        </section>

        <aside>
            @if (_view.Error is { } error)
            {
                <div class="card error"><strong>Something went wrong</strong><p>@error</p></div>
            }

            <div class="card meters">
                <div class="meter">
                    <span class="label">@Game.Theme.Label("health")</span>
                    @if (_view.Health is { } health)
                    {
                        <div class="bar"><div class="fill @HealthClass(health)" style="width:@Percent(health)"></div></div>
                        <span class="value">@Percent(health)</span>
                    }
                    else
                    {
                        <span class="value muted">not measured yet</span>
                    }
                </div>
                <div class="meter">
                    <span class="label">Intrusions</span>
                    @if (_view.Intrusions is { } intrusions)
                    {
                        <span class="value @(intrusions == 0 ? "good" : "bad")">@intrusions</span>
                    }
                    else
                    {
                        <span class="value muted">not measured yet</span>
                    }
                </div>
                @if (_view.GateState is { } gate)
                {
                    <p class="gate-state">The gate now: @gate</p>
                }
            </div>

            @if (_view.Phase == GamePhase.Completed)
            {
                <div class="card summary">
                    <strong>Scenario complete: @_view.TotalXp XP</strong>
                    <table>
                        @foreach (var o in _view.Outcomes)
                        {
                            <tr>
                                <td>Wave @o.Wave</td>
                                <td>@o.Title</td>
                                <td class="num">@o.Xp XP</td>
                                <td>@(o.Mastered ? "mastered" : $"{o.HintsUsed} hint(s)")</td>
                            </tr>
                        }
                    </table>
                </div>
            }

            @if (_view.CheatMode && _view.Answers is { } answers)
            {
                <div class="card answers">
                    <strong>Cheat mode: the answers</strong>
                    <p class="muted small">Paste a wave's commands into the terminal. Waves not held before cheat mode give @GameSession.MinimumXp XP and are not mastered.</p>
                    @foreach (var answer in answers)
                    {
                        var held = _view.Outcomes.Any(o => o.Wave == answer.Wave);
                        <div class="answer @(answer.Wave == _view.CurrentWave ? "current" : "") @(held ? "held" : "")">
                            <div class="answer-title">
                                <span>Wave @answer.Wave: @answer.Title@(held ? " (held)" : "")</span>
                                <button class="secondary small" @onclick="() => CopyAsync(answer.Steps)">Copy</button>
                            </div>
                            <pre class="steps">@answer.Steps</pre>
                            <p class="discussion"><strong>The question:</strong> @answer.Discussion</p>
                        </div>
                    }
                </div>
            }

            @if (_view.Briefing is { } briefing)
            {
                <div class="card mission">
                    <pre>@briefing</pre>
                </div>
            }
            else if (_view.Phase == GamePhase.Idle)
            {
                <div class="card mission">
                    <p>Press <strong>Start</strong>. The lab is built, and the first mission appears here.</p>
                    <p>You work in the terminal, as root in the gate. Type <code>quest</code> there for the mission,
                        <code>quest hint</code> when stuck, and <code>quest ready</code> to ring the bell.</p>
                </div>
            }

            @if (!_view.Active)
            {
                var progress = Game.History.Progress(_scenario);
                <div class="card progress">
                    <strong>Your progress</strong>
                    @if (progress.All(p => p.Played == 0))
                    {
                        <p class="muted">Nothing played yet. Every game you play is kept, and this shows which skills you have and which need practice.</p>
                    }
                    else
                    {
                        <table>
                            <tr><th>Wave</th><th>Skill</th><th class="num">Best</th><th>Status</th></tr>
                            @foreach (var p in progress)
                            {
                                <tr class="@(p.Mastered > 0 ? "mastered" : p.Held > 0 ? "held" : p.Played > 0 ? "stuck" : "")">
                                    <td>@p.Wave</td>
                                    <td>@p.Skill
                                        @if (p.Mastered == 0 && p.StuckOn is { } stuck)
                                        {
                                            <div class="muted small">Fell most on: @stuck</div>
                                        }
                                    </td>
                                    <td class="num">@(p.Held > 0 ? $"{p.BestXp} XP" : "")</td>
                                    <td>@Status(p)</td>
                                </tr>
                            }
                        </table>
                    }
                </div>
            }

            @if (_view.Log.Count > 0)
            {
                <div class="card log">
                    @foreach (var entry in _view.Log.Reverse())
                    {
                        <div class="entry @entry.Kind">
                            <div class="entry-title"><span class="time">@entry.At.ToString("HH:mm")</span> @entry.Title</div>
                            @if (entry.Text.Length > 0)
                            {
                                <pre>@entry.Text</pre>
                            }
                        </div>
                    }
                </div>
            }
        </aside>
    </main>
</div>

@code {
    private GameView _view = GameView.Empty;
    private Scenario _scenario = default!;
    private int _firstWave;
    private bool _busy;
    private static readonly int[] _waveChoices = [0, 1, 2, 3];

    protected override void OnInitialized()
    {
        _view = Game.View;
        _scenario = Game.LoadScenario();
        _firstWave = Game.History.SuggestedWave(_scenario);
        Game.Changed += OnChanged;
    }

    public void Dispose() => Game.Changed -= OnChanged;

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        _view = Game.View;
        StateHasChanged();
    });

    private async Task StartAsync()
    {
        _busy = true;
        try
        {
            await Game.StartAsync(_firstWave);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StopAsync()
    {
        _busy = true;
        try
        {
            await Game.StopAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void ToggleCheat()
    {
        if (_view.CheatMode) Game.HideAnswers();
        else Game.ShowAnswers();
    }

    private async Task CopyAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch (JSException)
        {
            // The browser refused the clipboard; the text is still there to select.
        }
    }

    private string PhaseText => _view.Phase switch
    {
        GamePhase.Building => "Building the lab...",
        GamePhase.Judging => "The wave is coming...",
        _ => $"Wave {_view.CurrentWave}",
    };

    private static string Status(SkillProgress p) =>
        p.Mastered > 0 ? "mastered"
        : p.Held > 0 && p.HeldWithoutAnswer == 0 ? "held with the answer"
        : p.Held > 0 ? $"held, {p.HintsUsed} hint(s)"
        : p.Played > 0 ? $"not held yet, {p.FailedAttempts} {(p.FailedAttempts == 1 ? "try" : "tries")}"
        : "not played";

    private static string Percent(double value) => $"{Math.Round(value * 100):0}%";

    private static string HealthClass(double value) => value >= 0.95 ? "good" : value >= 0.7 ? "warn" : "bad";
}
